# Lombok emits @lombok.Generated on everything it writes when — and only when — told to.
#
# JaCoCo skips anything carrying that annotation, so this one line is the difference between
# measuring the code in src/main/java and measuring it plus the equals/hashCode/toString/builder
# methods Lombok generates in the fourteen classes that use it. Those land hardest on
# availability.domain and booking, which are the two packages the coverage gate in pom.xml holds
# to 90 % branch coverage — so without this the gate is partly grading generated code.
#
# It changes nothing at runtime. @Generated is a marker; nothing reads it but tooling.
lombok.addLombokGeneratedAnnotation = true
