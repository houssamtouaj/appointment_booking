# Lombok emits @lombok.Generated on everything it writes when — and only when — told to.
#
# Both JaCoCo and SonarQube skip anything annotated @Generated, so this one line is the
# difference between measuring the code in src/main/java and measuring it plus several hundred
# generated equals/hashCode/toString/builder methods that no test will ever call directly. The
# symptom of leaving it out is a coverage figure that reads as a testing failure and is a
# configuration one, and it lands hardest on exactly the two packages the JaCoCo gate in
# pom.xml holds to 90 % branch coverage: `availability.domain` and `booking` are entity- and
# value-object-heavy, so they carry the most Lombok.
#
# It changes no behaviour at runtime. @Generated is a source/class-level marker; nothing reads
# it but analysis tooling.
lombok.addLombokGeneratedAnnotation = true
