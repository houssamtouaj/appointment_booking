<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.slotflow</groupId>
    <artifactId>slotflow-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>slotflow-api</name>
    <description>SlotFlow multi-tenant appointment and booking platform API</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>2.8.17</springdoc.version>
        <jjwt.version>0.12.7</jjwt.version>
        <stripe.version>33.3.0</stripe.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <!-- Not managed by the Boot parent, so pinning it here is the only pin there is. -->
        <jacoco.version>0.8.13</jacoco.version>

        <!-- Empty by design. Two things append to the test JVM's arguments without touching the
             argLine blocks: an ad-hoc `-Dtest.jvm.args.extra=...` for a one-off check, and
             JaCoCo's prepare-agent (`<propertyName>jacocoArgs</propertyName>`). Both need a
             declared default, because an undefined placeholder reaches the JVM literally and it
             will not start.

             They are then read with *different* syntax in the argLines below, and that difference
             is the whole reason this comment is long. `${...}` is resolved once, when Maven builds
             the POM model, which is before any plugin has run — fine for a value supplied on the
             command line, and silently useless for one a plugin sets later: prepare-agent does set
             `jacocoArgs`, and `${jacocoArgs}` has by then already been replaced by the empty
             default above. The symptom is a green build reporting near-zero coverage, because the
             report finds whatever stale target/jacoco.exec happens to be on disk.

             `@{...}` is Surefire and Failsafe's own late replacement, evaluated when the plugin
             forks, which is after prepare-agent. So the agent has to be `@{jacocoArgs}`, and the
             empty default is still required for `mvn test -Djacoco.skip=true`. -->
        <jacocoArgs></jacocoArgs>
        <test.jvm.args.extra></test.jvm.args.extra>
    </properties>

    <dependencies>
        <!-- ============================ Spring Boot starters ============================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================ Persistence and migrations ====================== -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================ API documentation =============================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============================ Mapping ========================================= -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ============================ Auth tokens ===================================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================ Payments ======================================== -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>${stripe.version}</version>
        </dependency>

        <!-- ============================ Rate limiting (D12) ============================= -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- ============================ Boilerplate ===================================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================ Test ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      Processor order is load-bearing, not cosmetic. Lombok must run before
                      MapStruct, and lombok-mapstruct-binding is what makes MapStruct wait for
                      the accessors Lombok generates. Get this wrong and mappers still compile
                      while mapping every field to null at runtime.
                      ProcessorSmokeMapperTest fails loudly if this list is ever disturbed.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        <arg>-Amapstruct.suppressGeneratorTimestamp=true</arg>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Unit tests (*Test) run on every build and need nothing but a JDK. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- lets `mvn -Dit.test=SomeIT verify` reach failsafe instead of failing
                         here on an empty surefire selection. Note the property name: failsafe
                         reads `it.test`, surefire reads `test`, and neither substitutes for the
                         other — `-Dtest=SomeIT verify` filters surefire only and still runs
                         every IT. Both plugins also set failIfNoSpecifiedTests=false, so a
                         typo'd selector is a green build that ran nothing: when selecting a
                         single IT, read the failsafe summary, not the exit code. -->
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    <!--
                      Pins the locale for the whole test JVM. Bean-validation messages
                      ("must not be blank") are resolved through Locale.getDefault(), and the
                      problem-detail contract test asserts on them literally. Without this the
                      suite passes on an English machine and fails on a French one. It has to be
                      a JVM argument, not a systemPropertyVariable: Locale.getDefault() is
                      resolved during JVM startup, before those are applied.

                      The two auth properties are here for a related reason: they belong to the
                      build, not to the code under test. JWT_SECRET is environment-only by design,
                      so a context that starts in a test needs a throwaway key from somewhere, and
                      putting it in an application.yml under src/test/resources would shadow the
                      real one. BCrypt at strength 4 turns a suite that signs in a hundred times
                      from twenty-five seconds of key stretching into half a second; production
                      stays at 12 (application.yml).
                    -->
                    <argLine>-Duser.language=en -Duser.country=US
                        -Dapp.security.jwt.secret=slotflow-test-signing-key-not-a-secret-0123456789
                        -Dapp.security.bcrypt-strength=4
                        @{jacocoArgs} ${test.jvm.args.extra}</argLine>
                </configuration>
            </plugin>

            <!-- Integration tests (*IT) need Docker for Testcontainers; bound to `verify`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    <!-- Same three arguments, same reasons; see the surefire block above. -->
                    <argLine>-Duser.language=en -Duser.country=US
                        -Dapp.security.jwt.secret=slotflow-test-signing-key-not-a-secret-0123456789
                        -Dapp.security.bcrypt-strength=4
                        @{jacocoArgs} ${test.jvm.args.extra}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Coverage, enforced only where it means something (plan 14 step 5).

              Declared after failsafe on purpose: within one phase Maven runs plugins in the order
              the POM lists them, and `report` has to see the exec file that failsafe:verify has
              just finished writing to. Swap the two blocks and the report covers unit tests only,
              silently, and the gates below start measuring the wrong thing.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!--
                      One agent, one exec file, both test phases. `append` defaults to true, so
                      the failsafe fork adds to what the surefire fork wrote rather than replacing
                      it: coverage of a class exercised only through an integration test still
                      counts. Two separate destFiles would need a merge step and would make it
                      possible to gate on half the evidence.

                      The argument reaches both JVMs through @{jacocoArgs} — the late-evaluated
                      spelling, for the reason set out at length beside the property declaration:
                      ${jacocoArgs} is substituted before this goal has run and produces a build
                      that reports coverage of nothing while passing.
                    -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgs</propertyName>
                        </configuration>
                    </execution>

                    <!-- The human-readable number the README quotes. -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <!--
                      The gate. Two packages, and deliberately no global threshold: a
                      project-wide number is met by testing getters, and this build would rather
                      fail on the availability engine than on a DTO.

                      element=PACKAGE with an include list means the rule is evaluated once per
                      matching package, so a package that matches nothing is not a failure — it is
                      simply not checked. That is the one failure mode here: a rename to
                      `com.slotflow.scheduling` would leave a green build with no gate on the two
                      things worth gating. CoverageGateTest asserts both names, so that rename is a
                      red test instead of a silent one.
                    -->
                    <execution>
                        <id>check-engine-and-booking</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.slotflow.availability.domain</include>
                                        <include>com.slotflow.booking</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
