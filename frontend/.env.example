# =====================================================================================
# Copy to frontend/.env.local before `npm run dev`. Vite loads .env.local and git
# ignores it; this file is not ignored, so it must never hold a real credential.
#
#   cp .env.example .env.local
#
# Every comment here sits *above* the value it describes, never after it — the same
# rule the root .env.example states, and for the same reason: several of the tools
# that read a dotenv file do not strip a trailing `# ...`, so an inline comment
# silently becomes part of the value.
#
# One rule specific to this side of the boundary: **nothing here is a secret.** Vite
# inlines every VITE_* into the JavaScript bundle at build time, so anything in this
# file ships to the browser in readable form. A variable that must stay private is a
# variable that belongs in the backend's environment, not this one.
#
# Anything NOT prefixed VITE_ is invisible to the app. That is Vite's rule, not ours.
# =====================================================================================

# --- API ------------------------------------------------------------------------------
# Origin of the SlotFlow API, no trailing slash. The app appends /api itself.
#
# Baked at build time, which makes deployment a three-step handshake (F18): the SPA
# needs the Render URL to build, and Render needs the resulting Vercel URL for
# CORS_ALLOWED_ORIGINS and FRONTEND_BASE_URL. Build the SPA first against the known
# API URL, take the Vercel URL, set both Render variables, then redeploy the API.
# Out of order, the demo 401s on every refresh.
#
# 8081 rather than 8080 locally: docker-compose maps the API there because 8080 is
# often already taken on a Windows host, and the failure when it is looks like an
# application error rather than a port collision.
VITE_API_BASE_URL=http://localhost:8081

# How the dev server reaches the API (F2). Three modes, and the default is the
# awkward one on purpose:
#
#   direct     — the browser calls VITE_API_BASE_URL cross-origin. This is the
#                default because it is the only local mode that exercises CORS,
#                allowCredentials and withCredentials, which production needs and
#                one of which is unforgiving.
#   proxy      — Vite proxies /api, making everything same-origin. Convenient, and
#                it hides all three of the above. Reach for it to debug something
#                else, not to develop against.
#   crosssite  — serve the SPA from http://127.0.0.1:5173 against localhost:8081.
#                A bare IP has no registrable domain, so browsers treat that pair
#                as cross-*site* while still granting loopback a secure context.
#                It is the only local way to prove the refresh cookie survives
#                SameSite=None; Secure before the production URL exists.
#
# `crosssite` also needs the API restarted with REFRESH_COOKIE_SAME_SITE=None and
# REFRESH_COOKIE_SECURE=true (the app refuses to start with None and Secure=false),
# and `http://127.0.0.1:5173` added to CORS_ALLOWED_ORIGINS in the root .env.
VITE_API_MODE=direct

# --- Demo ------------------------------------------------------------------------------
# Slug that the bare `/` route redirects to (F16). Public booking pages live under
# /b/:slug, so `/` needs a business to open, and there is no endpoint that lists
# businesses — the portfolio link has to land on something alive.
#
# `demo-salon` is what the backend's `demo` Spring profile seeds: Europe/Paris, EUR,
# three staff, six services. Leave it unless you have seeded a different tenant.
VITE_DEMO_SLUG=demo-salon
