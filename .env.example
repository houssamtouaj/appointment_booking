# =====================================================================================
# Copy to .env before `docker compose up`. .env is git-ignored; this file is not, so it
# must never hold a real credential.
#
#   cp .env.example .env
#
# Every comment here sits *above* the value it describes, never after it. `docker compose`
# strips a trailing `# ...` from a value, but `docker run --env-file` and `set -a; . ./.env`
# — the shell route the `local` Spring profile documents — do not. With an inline comment,
# POSTGRES_PASSWORD becomes the password plus the sentence explaining it, and the
# authentication failure that follows points at the password rather than at this file.
# =====================================================================================

# --- Spring profiles -----------------------------------------------------------------
# `demo` seeds a salon with three staff, six services and about forty bookings across the last
# three weeks and the next two, and registers POST /api/auth/demo-login. That is what makes
# `docker compose up` from a clean clone a *working* demo rather than an empty database, and it
# is what the deployed instance runs. The seeder is idempotent: it skips entirely once the demo
# business exists, so a restart never duplicates it.
#
# Leave it empty for a bare instance. The demo-login route then does not exist, and the security
# allowlist does not open its path either — the two are gated separately on purpose.
SPRING_PROFILES_ACTIVE=demo

# --- Postgres -----------------------------------------------------------------------
# Database created on first boot of an empty volume.
POSTGRES_DB=slotflow
# Owner role the api connects as.
POSTGRES_USER=slotflow
# Local only; a real deployment injects a generated value.
POSTGRES_PASSWORD=change-me-locally
# Host port for psql and GUI clients.
POSTGRES_PORT=5432

# --- Database connection --------------------------------------------------------------
# Compose builds all three of these for the api container out of the Postgres block above,
# so leave them unset for `docker compose up`. They exist for the other route: the app
# running on the host against the Compose database, which is what the `local` profile is
# for. Nothing sources this file automatically, so that route needs it loaded into the
# shell first:
#
#   set -a; . ./.env; set +a
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# DB_PASSWORD falls back to POSTGRES_PASSWORD (application.yml), so uncomment these only to
# point at some database other than the one Compose runs.
# DB_URL=jdbc:postgresql://localhost:5432/slotflow
# DB_USERNAME=slotflow
# DB_PASSWORD=
#
# Hikari's maximum pool size. Ten is right for a single instance; a free-tier managed Postgres
# often caps total connections near twenty, so two instances at ten each is how a deploy runs out
# of connections rather than out of memory.
# DB_POOL_MAX=10

# --- API ------------------------------------------------------------------------------
# Host port for the API.
API_PORT=8080
# The port the application itself binds. Unset is right almost everywhere: it falls back to the
# platform's own PORT variable and then to 8080, which is what lets the same image run on Railway,
# Render or Fly without a per-platform override.
# SERVER_PORT=8080
# PORT is the same knob under the name Railway, Render, Fly and Heroku inject it as, and the
# platform sets it — this line documents that the app reads it, not that you should.
# PORT=8080
# `framework` behind a proxy that terminates TLS, so redirect URIs and the rate limiter see the
# real scheme and client IP. Only set it when certain the proxy *overwrites* X-Forwarded-For rather
# than appending to whatever the caller sent — otherwise a client can choose its own rate-limit key.
# FORWARD_HEADERS_STRATEGY=framework
# Base URL advertised in the OpenAPI document.
PUBLIC_API_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth (plan 05) -------------------------------------------------------------------
# HS256 signing key for access tokens. At least 32 bytes; generate per environment:
#   openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-bytes-of-random
# The refresh token rides in an httpOnly cookie. Set this to true wherever the browser
# reaches the API over TLS; on plain-HTTP localhost it must stay false or the browser
# drops the cookie and every refresh fails without saying why.
REFRESH_COOKIE_SECURE=false
# Lax, Strict or None. Lax is right whenever the SPA and the API share a registrable domain,
# localhost included, and it is what makes CSRF a non-question for /api/auth/refresh and
# /logout. A deployment that splits them across domains — the SPA on Vercel, the API on
# Render — is cross-site, and a Lax cookie is never attached to a cross-site request: refresh
# 401s and every session dies at the access-token TTL. Such a deployment must set None, which
# requires REFRESH_COOKIE_SECURE=true (the app refuses to start otherwise) and gives up the
# SameSite half of the CSRF argument — see RefreshTokenCookie for what remains.
# REFRESH_COOKIE_SAME_SITE=Lax
# BCrypt cost. 12 is roughly a quarter of a second per verification, which is the point: it makes
# an offline attack on a stolen table expensive. Lower it only if a constrained free tier cannot
# afford it, and know that is the trade being made.
# BCRYPT_STRENGTH=12
# Where the SPA is served from — used to build every link in outbound mail, each of which puts
# its token in the path: {FRONTEND_BASE_URL}/accept-invitation/{token}, /reset-password/{token},
# and /booking/{cancellationToken} for the manage page every customer message carries.
FRONTEND_BASE_URL=http://localhost:5173
# When to delete expired refresh and reset tokens. refresh_token gains a row on every login and
# every rotation and nothing else deletes one, so this is what keeps the largest table in the
# schema from growing forever. Set to `-` to disable the job.
TOKEN_SWEEP_CRON=0 15 3 * * *

# --- Mail ------------------------------------------------------------------------------
# Host port MailHog listens on for SMTP.
MAILHOG_SMTP_PORT=1025
# MailHog web UI: http://localhost:8025
MAILHOG_UI_PORT=8025
# Whether this deployment sends mail at all. false swaps the SMTP transport for the logging one:
# no templates, no relay, every message and its links written to the api log instead. That is the
# demo profile, and the switch that keeps a dead relay from taking a feature down.
MAIL_ENABLED=true
# From: address on every outbound mail. A real relay will refuse a From it does not own.
MAIL_FROM=no-reply@slotflow.local
# The relay itself. Compose points the api container at MailHog, so these are only for the other
# two routes: the app running on the host, and a real deployment. A verified sender domain is not
# optional at a provider like Resend or Brevo — MAIL_FROM must be an address the relay owns, or
# every message is refused with a 550 that names the domain and not this file.
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# --- Payments (plan 11, test mode only) -------------------------------------------------
# Off means every booking is created CONFIRMED and nothing ever reaches Stripe, which is what
# keeps the deployed demo working when a test key expires. Turning it on WITHOUT
# STRIPE_SECRET_KEY is a startup failure, deliberately: the alternative is an app that boots and
# then fails on the first customer who tries to pay, by which point their slot has been held for
# half an hour for nothing.
PAYMENTS_ENABLED=false
# Test-mode API key from the Stripe dashboard.
STRIPE_SECRET_KEY=
# Signing secret printed by `stripe listen`. This is the entire authentication of
# POST /api/webhooks/stripe: anyone who can reach that path can claim a booking is paid, and only
# somebody holding this can prove it.
#
#   stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Scheduled jobs ---------------------------------------------------------------------
# Cancels PENDING bookings whose deposit never arrived (D3). Every minute; `-` disables it.
BOOKING_EXPIRY_SWEEP_CRON=0 * * * * *
# The 24-hour reminder. Its window overlaps deliberately so a missed run catches up, and
# reminder_sent_at makes the overlap free. `-` disables it.
BOOKING_REMINDER_CRON=0 */15 * * * *

# --- Rate limiting (D12) ----------------------------------------------------------------
# In-memory Bucket4j buckets on the unauthenticated write endpoints, per IP and per guest email.
# The budgets are per instance, so a two-container deploy doubles them. Off is for a load test
# against a private instance and nothing else: these endpoints create rows and send mail, and they
# are the first thing a technical reviewer probes.
# RATE_LIMIT_ENABLED=true
