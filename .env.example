# =====================================================================================
# Copy to .env before `docker compose up`. .env is git-ignored; this file is not, so it
# must never hold a real credential.
#
#   cp .env.example .env
# =====================================================================================

# --- Postgres -----------------------------------------------------------------------
POSTGRES_DB=slotflow                  # database created on first boot of an empty volume
POSTGRES_USER=slotflow                # owner role the api connects as
POSTGRES_PASSWORD=change-me-locally   # local only; a real deployment injects a generated value
POSTGRES_PORT=5432                    # host port for psql/GUI clients

# --- API ------------------------------------------------------------------------------
API_PORT=8080                                     # host port for the API
PUBLIC_API_URL=http://localhost:8080              # base URL advertised in the OpenAPI document
CORS_ALLOWED_ORIGINS=http://localhost:5173        # comma-separated browser origins allowed to call the API

# --- Auth (plan 05) -------------------------------------------------------------------
# HS256 signing key for access tokens. At least 32 bytes; generate per environment:
#   openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-bytes-of-random

# --- Mail ------------------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025                    # host port MailHog listens on for SMTP
MAILHOG_UI_PORT=8025                      # MailHog web UI: http://localhost:8025
MAIL_FROM=no-reply@slotflow.local         # From: address on every outbound mail
# Only needed when pointing at a real SMTP provider instead of MailHog:
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# --- Stripe (plan 11, test mode only) ---------------------------------------------------
STRIPE_SECRET_KEY=                # test-mode API key from the Stripe dashboard
STRIPE_WEBHOOK_SECRET=            # signing secret printed by `stripe listen`
