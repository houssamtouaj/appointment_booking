# ---------------------------------------------------------------------
# Secrets & environment
# Never commit Stripe keys, JWT secrets, or DB credentials.
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
# application-local.yml IS committed: it only points at the Compose services and
# holds no credentials. Personal overrides belong in application-local-<name>.yml.
application-local-*.yml
application-local-*.properties
*.pem
*.key

